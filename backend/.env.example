# Copy this file to .env and adjust as needed.
# All variables are prefixed with ARCHERO_ (see app/core/config.py).

ARCHERO_APP_NAME="Archero 2 Optimizer"
ARCHERO_ENVIRONMENT=development
ARCHERO_DEBUG=true

# SQLite by default. To use PostgreSQL instead:
# ARCHERO_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/archero2
ARCHERO_DATABASE_URL=sqlite:///./database/archero2.db

ARCHERO_LOG_LEVEL=INFO

# Log every SQL statement SQLAlchemy executes. Off by default: noisy and
# can log user-entered values. Turn on only when actively debugging a
# query.
ARCHERO_SQL_ECHO=false
